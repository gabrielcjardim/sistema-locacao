# Cadastre estas variáveis no ambiente Production da Vercel.
# Nunca coloque a senha real neste arquivo nem envie segredos ao GitHub.
AMBIENTE_APLICACAO=producao
DATABASE_URL=postgresql://usuario:senha@servidor:5432/meus_aptos_producao?sslmode=require
AUTENTICACAO_OBRIGATORIA=true
USUARIO_ADMIN=administrador
SENHA_ADMIN_HASH=cole_aqui_o_hash_gerado
SEGREDO_DA_SESSAO=use_um_valor_aleatorio_com_no_minimo_32_caracteres
LICENCIAMENTO_ATIVO=true
LICENCA_SISTEMA_ID=sistema-locacao
LICENCA_INSTALACAO_ID=uuid-exclusivo-desta-instalacao
LICENCA_CHAVE_PUBLICA=chave-publica-da-central
LICENCA_VALIDACAO_INICIAL_URL=https://sua-central.example.com/api/validacao
LICENCA_INTERVALO_VERIFICACAO_SEGUNDOS=200
