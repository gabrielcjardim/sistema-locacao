# Copie para .env.development.local no computador de desenvolvimento.
AMBIENTE_APLICACAO=desenvolvimento
AUTENTICACAO_OBRIGATORIA=false

# Vazio no desenvolvimento usa dados-locais/banco.json.
# Informe uma URL somente se quiser testar com um PostgreSQL de desenvolvimento.
DATABASE_URL=

# A ativação online registra automaticamente o endereço e o segredo de comunicação.
LICENCIAMENTO_ATIVO=true
LICENCA_SISTEMA_ID=sistema-locacao
LICENCA_INSTALACAO_ID=uuid-da-instalacao
LICENCA_CHAVE_PUBLICA=chave-publica-da-central
LICENCA_VALIDACAO_INICIAL_URL=http://127.0.0.1:3200/api/validacao
LICENCA_INTERVALO_VERIFICACAO_SEGUNDOS=200
